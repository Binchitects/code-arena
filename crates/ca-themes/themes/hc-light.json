  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#515151"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#0F4A85"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#096D48"
      }
