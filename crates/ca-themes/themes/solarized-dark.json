{
  "name": "Solarized Dark",
  "type": "dark",
  "colors": {
    "terminal.ansiBlack": "#000000",
    "terminal.ansiRed": "#CD3131",
    "terminal.ansiGreen": "#0DBC79",
    "terminal.ansiYellow": "#E5E510",
    "terminal.ansiBlue": "#2472C8",
    "terminal.ansiMagenta": "#BC3FBC",
    "terminal.ansiCyan": "#11A8CD",
    "terminal.ansiWhite": "#E5E5E5",
    "terminal.ansiBrightBlack": "#666666",
    "terminal.ansiBrightRed": "#F14C4C",
    "terminal.ansiBrightGreen": "#23D18B",
    "terminal.ansiBrightYellow": "#F5F543",
    "terminal.ansiBrightBlue": "#3B8EEA",
    "terminal.ansiBrightMagenta": "#D670D6",
    "terminal.ansiBrightCyan": "#29B8DB",
    "terminal.ansiBrightWhite": "#E5E5E5",
    "foreground": "#839496",
    "descriptionForeground": "#93A1A1",
    "errorForeground": "#FFEEEE",
    "focusBorder": "#2AA19899",
    "editor.background": "#002B36",
    "editor.foreground": "#839496",
    "editor.lineHighlightBackground": "#073642",
    "editorWidget.background": "#00212B",
    "sideBar.background": "#00212B",
    "sideBar.border": "#003847",
    "activityBar.background": "#003847",
    "activityBar.foreground": "#93A1A1",
    "activityBar.activeBorder": "#2AA198",
    "statusBar.background": "#00212B",
    "statusBar.foreground": "#93A1A1",
    "titleBar.activeBackground": "#002C39",
    "titleBar.activeForeground": "#93A1A1",
    "panel.background": "#00212B",
    "panel.border": "#2B2B4A",
    "tab.activeBackground": "#002B36",
    "tab.inactiveBackground": "#004052",
    "tab.border": "#003847",
    "editorGroupHeader.tabsBackground": "#004052",
    "button.background": "#2AA19899",
    "button.foreground": "#FFFFFF",
    "input.background": "#003847",
    "list.hoverBackground": "#004454AA",
    "list.activeSelectionBackground": "#005A6F",
    "textCodeBlock.background": "#073642",
    "widget.border": "#003847",
    "terminal.background": "#002B36",
    "terminal.foreground": "#839496",
    "testing.iconPassed": "#859900"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#586E75",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#2AA198"
      }
    },
    {
      "scope": "constant.numeric, constant.language",
      "settings": {
        "foreground": "#D33682"
      }
    },
    {
      "scope": "keyword, storage",
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "scope": "storage.type",
      "settings": {
        "foreground": "#93A1A1"
      }
    },
    {
      "scope": "entity.name.type, entity.name.class, support.type",
      "settings": {
        "foreground": "#CB4B16"
      }
    },
    {
      "scope": "entity.name.function, support.function",
      "settings": {
        "foreground": "#268BD2"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#268BD2"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#268BD2"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#93A1A1"
      }
    }
  ]
}
