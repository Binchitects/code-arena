{
  "name": "Dark+",
  "type": "dark",
  "colors": {
    "terminal.ansiBlack": "#000000",
    "terminal.ansiRed": "#CD3131",
    "terminal.ansiGreen": "#0DBC79",
    "terminal.ansiYellow": "#E5E510",
    "terminal.ansiBlue": "#2472C8",
    "terminal.ansiMagenta": "#BC3FBC",
    "terminal.ansiCyan": "#11A8CD",
    "terminal.ansiWhite": "#E5E5E5",
    "terminal.ansiBrightBlack": "#666666",
    "terminal.ansiBrightRed": "#F14C4C",
    "terminal.ansiBrightGreen": "#23D18B",
    "terminal.ansiBrightYellow": "#F5F543",
    "terminal.ansiBrightBlue": "#3B8EEA",
    "terminal.ansiBrightMagenta": "#D670D6",
    "terminal.ansiBrightCyan": "#29B8DB",
    "terminal.ansiBrightWhite": "#E5E5E5",
    "foreground": "#CCCCCC",
    "descriptionForeground": "#A0A0A0",
    "errorForeground": "#F48771",
    "focusBorder": "#007FD4",
    "editor.background": "#1E1E1E",
    "editor.foreground": "#D4D4D4",
    "editorWidget.background": "#252526",
    "sideBar.background": "#252526",
    "sideBar.border": "#333333",
    "activityBar.background": "#333333",
    "activityBar.foreground": "#FFFFFF",
    "activityBar.inactiveForeground": "#FFFFFF66",
    "activityBar.activeBorder": "#FFFFFF",
    "statusBar.background": "#007ACC",
    "statusBar.foreground": "#FFFFFF",
    "titleBar.activeBackground": "#3C3C3C",
    "titleBar.activeForeground": "#CCCCCC",
    "panel.background": "#1E1E1E",
    "panel.border": "#80808059",
    "tab.activeBackground": "#1E1E1E",
    "tab.inactiveBackground": "#2D2D2D",
    "tab.border": "#252526",
    "editorGroupHeader.tabsBackground": "#252526",
    "button.background": "#0E639C",
    "button.foreground": "#FFFFFF",
    "button.secondaryBackground": "#3A3D41",
    "input.background": "#3C3C3C",
    "list.hoverBackground": "#2A2D2E",
    "list.activeSelectionBackground": "#04395E",
    "textCodeBlock.background": "#0A0A0A66",
    "widget.border": "#454545",
    "terminal.background": "#1E1E1E",
    "terminal.foreground": "#CCCCCC",
    "testing.iconPassed": "#73C991"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#6A9955"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#D16969"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#B5CEA8"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "scope": "keyword, storage",
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "scope": "keyword.control",
      "settings": {
        "foreground": "#C586C0"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "scope": "entity.name.type, support.type, entity.name.class",
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "scope": "entity.name.function, support.function",
      "settings": {
        "foreground": "#DCDCAA"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "scope": "meta.annotation, entity.name.decorator",
      "settings": {
        "foreground": "#DCDCAA"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#569CD6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "invalid",
      "settings": {
        "foreground": "#F44747"
      }
    },
    {
      "scope": "support.macro, entity.name.function.macro, entity.name.operator.custom-literal",
      "settings": {
        "foreground": "#DCDCAA"
      }
    },
    {
      "scope": "entity.name.namespace, entity.name.scope-resolution, entity.other.inherited-class, support.class, entity.name.type.module",
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "scope": "variable.other.constant, variable.other.enummember",
      "settings": {
        "foreground": "#4FC1FF"
      }
    },
    {
      "scope": "meta.definition.variable.name, support.variable, entity.name.variable, variable.parameter",
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#D7BA7D"
      }
    },
    {
      "scope": "storage.type, storage.modifier, keyword.other, keyword.declaration, meta.preprocessor",
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "scope": "keyword.control, keyword.other.directive, keyword.operator.new, keyword.operator.expression, keyword.other.operator, keyword.other.using",
      "settings": {
        "foreground": "#C586C0"
      }
    },
    {
      "scope": "punctuation.definition.tag",
      "settings": {
        "foreground": "#808080"
      }
    },
    {
      "scope": "punctuation.definition.template-expression.begin, punctuation.definition.template-expression.end",
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "scope": "support.type.property-name",
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "scope": "support.constant.property-value, support.constant.color, markup.inline.raw",
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "scope": "constant.regexp",
      "settings": {
        "foreground": "#646695"
      }
    },
    {
      "scope": "entity.name.label",
      "settings": {
        "foreground": "#C8C8C8"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline",
      "settings": {
        "fontStyle": "underline"
      }
    }
  ]
}
