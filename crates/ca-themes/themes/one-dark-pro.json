  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#91959e"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#98c379"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#98c379"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#d19a66"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#c678dd"
      }
    },
    {
      "scope": "keyword, storage",
      "settings": {
        "foreground": "#c678dd"
      }
    },
    {
      "scope": "keyword.control",
      "settings": {
        "foreground": "#c678dd"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#abb2bf"
      }
    },
    {
      "scope": "entity.name.type, support.type, entity.name.class",
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "scope": "entity.name.function, support.function",
      "settings": {
        "foreground": "#61afef"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#e2757d"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#c678dd"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#e2757d"
      }
    },
    {
      "scope": "meta.annotation, entity.name.decorator",
      "settings": {
        "foreground": "#61afef"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#c678dd",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "invalid",
      "settings": {
        "foreground": "#f66868"
      }
    },
    {
      "scope": "support.macro, entity.name.function.macro, entity.name.operator.custom-literal",
      "settings": {
        "foreground": "#61afef"
      }
    },
    {
      "scope": "entity.name.namespace, entity.name.scope-resolution, entity.other.inherited-class, support.class, entity.name.type.module",
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "scope": "variable.other.constant, variable.other.enummember",
      "settings": {
        "foreground": "#d19a66"
      }
    },
    {
      "scope": "meta.definition.variable.name, support.variable, entity.name.variable, variable.parameter",
      "settings": {
        "foreground": "#e2757d"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#98c379"
      }
    },
    {
      "scope": "storage.type, storage.modifier, keyword.other, keyword.declaration, meta.preprocessor",
      "settings": {
        "foreground": "#c678dd"
      }
    },
    {
      "scope": "keyword.control, keyword.other.directive, keyword.operator.new, keyword.operator.expression, keyword.other.operator, keyword.other.using",
      "settings": {
        "foreground": "#c678dd"
      }
    },
    {
      "scope": "punctuation.definition.tag",
      "settings": {
        "foreground": "#91959e"
      }
    },
    {
      "scope": "punctuation.definition.template-expression.begin, punctuation.definition.template-expression.end",
      "settings": {
        "foreground": "#c678dd"
      }
    },
    {
      "scope": "support.type.property-name",
      "settings": {
        "foreground": "#e2757d"
      }
    },
    {
      "scope": "support.constant.property-value, support.constant.color, markup.inline.raw",
      "settings": {
        "foreground": "#98c379"
      }
    },
    {
      "scope": "constant.regexp",
      "settings": {
        "foreground": "#98c379"
      }
    },
    {
      "scope": "entity.name.label",
      "settings": {
        "foreground": "#abb2bf"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline",
      "settings": {
        "fontStyle": "underline"
      }
    }
  ]
}
