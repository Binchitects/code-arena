%YAML 1.2
---
# Vue single-file components, written for Code Arena: HTML's grammar, with the `<script>` block as TypeScript (or
# JavaScript, which it also reads), the `<style>` block as CSS, and `{{ … }}` in the template as an expression.
name: Vue
file_extensions: [vue]
scope: text.html.vue
contexts:
  main:
    - match: '\{\{'
      scope: punctuation.definition.tag.begin.vue
      push: interpolation
    - match: '(<)(?i:(script))\b'
      captures:
        1: punctuation.definition.tag.begin.html
        2: entity.name.tag.script.html
      push: script
    - match: '(<)(?i:(style))\b'
      captures:
        1: punctuation.definition.tag.begin.html
        2: entity.name.tag.style.html
      push: style
    - include: scope:text.html.basic

  interpolation:
    - meta_scope: meta.interpolation.vue
    - meta_content_scope: source.ts.embedded.vue
    - match: '\}\}'
      scope: punctuation.definition.tag.end.vue
      pop: true
    - include: scope:source.ts#braced

  script:
    - meta_scope: meta.tag.script.html
    - match: '(</)(?i:(script))\s*(>)'
      captures:
        1: punctuation.definition.tag.begin.html
        2: entity.name.tag.script.html
        3: punctuation.definition.tag.end.html
      pop: true
    - match: '>'
      scope: punctuation.definition.tag.end.html
      embed: scope:source.ts
      embed_scope: source.ts.embedded.html
      escape: '(?i)(?=</script\s*>)'
    - include: attributes

  style:
    - meta_scope: meta.tag.style.html
    - match: '(</)(?i:(style))\s*(>)'
      captures:
        1: punctuation.definition.tag.begin.html
        2: entity.name.tag.style.html
        3: punctuation.definition.tag.end.html
      pop: true
    - match: '>'
      scope: punctuation.definition.tag.end.html
      embed: scope:source.css
      embed_scope: source.css.embedded.html
      escape: '(?i)(?=</style\s*>)'
    - include: attributes

  attributes:
    - match: '[^\s"''<>/=]+'
      scope: entity.other.attribute-name.html
    - match: '='
      scope: punctuation.separator.key-value.html
    - match: '"[^"]*"|''[^'']*'''
      scope: string.quoted.html
